# ── Database ──
DATABASE_URL=sqlite:///./jobs.db

# ── LLM API Keys (set ONE or BOTH) ──
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── Search Settings (override defaults from app/settings.py) ──
# LLM_PROVIDER=groq
# HEADLESS=true
# PAST_24_HOURS=true
# MAX_JOBS=300
# THRESHOLD=50

# ── Candidate Profile ──
# BASE_RESUME_PATH=./resume.pdf
# LINKEDIN_URL=https://www.linkedin.com/in/yourprofile
# GITHUB_URL=https://github.com/yourhandle